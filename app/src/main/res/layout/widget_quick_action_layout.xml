<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_quick_dock_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_dock"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <!-- Action 1: Run -->
    <LinearLayout
        android:id="@+id/widget_dock_run"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="3dp"
        android:layout_weight="1"
        android:background="@drawable/widget_dock_item_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingVertical="8dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_widget_run" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Run"
            android:textColor="@color/widget_text_primary"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Action 2: Walk -->
    <LinearLayout
        android:id="@+id/widget_dock_walk"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="3dp"
        android:layout_weight="1"
        android:background="@drawable/widget_dock_item_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingVertical="8dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_widget_walk" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Walk"
            android:textColor="@color/widget_text_primary"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Action 3: Workout -->
    <LinearLayout
        android:id="@+id/widget_dock_workout"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="3dp"
        android:layout_weight="1"
        android:background="@drawable/widget_dock_item_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingVertical="8dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_widget_dumbbell" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Workout"
            android:textColor="@color/widget_text_primary"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Action 4: Hydrate -->
    <LinearLayout
        android:id="@+id/widget_dock_water"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="3dp"
        android:layout_weight="1"
        android:background="@drawable/widget_dock_item_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingVertical="8dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_widget_water" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Water"
            android:textColor="@color/widget_text_primary"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Action 5: Stopwatch / Timer -->
    <LinearLayout
        android:id="@+id/widget_dock_timer"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="3dp"
        android:layout_weight="1"
        android:background="@drawable/widget_dock_item_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingVertical="8dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_widget_stopwatch" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Timer"
            android:textColor="@color/widget_text_primary"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>

